#!/bin/sh
set -eu

HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export APPDIR="${APPDIR:-$HERE}"

export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:${LD_LIBRARY_PATH:-}"
export WEBKIT_EXEC_PATH="$APPDIR/usr/lib/webkit2gtk-4.1"
export WEBKIT_DISABLE_SANDBOX=1
# WebKitGTK's accelerated compositor probes EGL/GBM before the window is
# available.  That probe is unreliable in AppImages across X11, Wayland,
# remote sessions, and software-rendered environments.  Keep the launcher
# usable everywhere; users with a known-good graphics stack can opt back in.
export WEBKIT_DISABLE_COMPOSITING_MODE="${WEBKIT_DISABLE_COMPOSITING_MODE:-1}"
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"

cd "$APPDIR/usr/lib/webkit2gtk-4.1"
exec "$APPDIR/usr/bin/flint" "$@"
